# Server-side ONLY. Set these in Supabase Edge Function secrets.
# Supabase supplies SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY automatically.
APP_ORIGIN=https://your-journal.pages.dev
ZERODHA_OWNER_USER_ID=your_supabase_auth_user_uuid
ZERODHA_CLIENT_ID=your_zerodha_client_id
ZERODHA_API_KEY=your_zerodha_api_key
ZERODHA_API_SECRET=your_zerodha_api_secret
ZERODHA_REDIRECT_URL=https://your-journal.pages.dev/dashboard/integrations/zerodha/callback
ZERODHA_TOKEN_ENCRYPTION_KEY=replace_with_random_32_bytes_base64

# News / MCP: server-side only. Never use VITE_ for these values.
NEWS_APP_ORIGIN=https://edgelog-iota-six.vercel.app
MARKETAUX_API_KEY=your_marketaux_api_key
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
# Free Marketaux plan: leave at 3. Increase only to your plan's article allowance.
NEWS_ARTICLES_PER_REQUEST=3
